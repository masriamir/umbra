{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/pre-commit-check.sh'",
            "timeout": 15,
            "statusMessage": "Checking staged files for credentials..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/docs-sync-check.sh'",
            "timeout": 10,
            "statusMessage": "Checking docs sync..."
          }
        ]
      }
    ]
  }
}
