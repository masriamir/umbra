{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": ".claude/hooks/pre-commit-check.sh",
            "timeout": 15,
            "statusMessage": "Checking staged files for credentials..."
          }
        ]
      }
    ]
  }
}
